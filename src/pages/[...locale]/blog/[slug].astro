---
/**
 * Blog post page. Posts are Markdown with frontmatter in content/<lang>/posts; the archive from the
 * previous site (75 posts, 2024) carries `archive: true` and `legacy_url` (301 from the old address).
 * Routes exist for every language that has posts, even languages not yet in the menu (doc 33 §3.3).
 */
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Related from '@/components/Related.astro';
import { getPosts } from '@/lib/data';
import { localePath, postPath, formatDate, tObject, t } from '@/lib/i18n';
import { languages, defaultLanguage, hosts } from '@config';

export async function getStaticPaths() {
  const out = [];
  for (const l of languages) {
    for (const post of await getPosts(l.code)) {
      out.push({ params: { locale: l.code === defaultLanguage ? undefined : l.code, slug: post.id.split('/').pop() }, props: { lang: l.code, post } });
    }
  }
  return out;
}

const { lang, post } = Astro.props;
const { Content } = await render(post);
const slug = post.id.split('/').pop()!;
const path = postPath(lang, slug);
const fmt = tObject<Intl.DateTimeFormatOptions>(lang, 'post.date');
const all = (await getPosts(lang)).filter((p) => p.id !== post.id);
// Read next: the two newest other posts plus the one right after this one chronologically.
const idx = all.findIndex((p) => p.data.date < post.data.date);
const next = [...all.slice(0, 2), ...(idx >= 2 ? [all[idx]] : [])].slice(0, 3);
const related = post.data.related ?? [
  { label: lang === 'ru' ? 'Тариф: за билет, без подписки' : 'Pricing: per ticket, no subscription', href: '/pricing' },
  { label: lang === 'ru' ? 'Где продавать: свой сайт или наша страница' : 'Where you sell: your site or ours', href: '/product/sell' },
  { label: lang === 'ru' ? 'Начать продавать' : 'Start selling', href: '/start' },
];
const blogIndex = localePath(lang, '/blog');
const crumbs = [{ name: 'Home', path: localePath(lang, '/') }, { name: t(lang, 'blog.backToIndex'), path: blogIndex }, { name: post.data.title, path }];
---
<Base
  lang={lang}
  path={path}
  title={post.data.title}
  description={post.data.description}
  markdownPath={`${path}.md`}
  jsonld={{ path, title: post.data.title, description: post.data.description, lang, breadcrumbs: crumbs, article: { headline: post.data.title, date: post.data.date, updated: post.data.updated, author: post.data.author } }}
>
  <article class="wrap post">
    <Breadcrumbs lang={lang} items={crumbs} />
    <header class="post-head">
      <p class="eyebrow"><time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(lang, post.data.date, fmt)}</time>{post.data.updated && <span> · {t(lang, 'post.updated', { date: formatDate(lang, post.data.updated, fmt) })}</span>}</p>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
    </header>
    {post.data.archive && (
      <aside class="archive-note" role="note">
        <b>{t(lang, 'archive.title')}.</b> {t(lang, 'archive.text', { year: post.data.date.getUTCFullYear() })} <a href={localePath(lang, '/changes')}>{t(lang, 'archive.link')}</a>
      </aside>
    )}
    {post.data.cover && <Image class="post-cover" src={post.data.cover} alt={post.data.cover_alt ?? ''} width={900} densities={[1, 2]} loading="eager" />}
    <div class="prose post-body"><Content /></div>
    <footer class="post-foot">
      <p class="hero-note" style="color:var(--fg-2)">{t(lang, 'post.author', { author: post.data.author })} · <a href={blogIndex} style="color:var(--accent);font-weight:600">{t(lang, 'blog.backToIndex')}</a> · <a href={hosts.telegramChat} style="color:var(--accent);font-weight:600">Telegram</a></p>
    </footer>
  </article>
  {next.length > 0 && <Related lang={lang} title={t(lang, 'blog.readNext')} items={next.map((p) => ({ label: p.data.title, href: postPath(lang, p.id.split('/').pop()!), text: p.data.description.slice(0, 120) }))} />}
  <Related lang={lang} title={t(lang, 'blog.related')} items={related} />
</Base>
<style is:global>
.post{padding-bottom:clamp(40px,6vw,72px)}
.post-head{padding-block:20px 0}
.post-head h1{font-size:clamp(30px,4.6vw,52px);font-weight:800;letter-spacing:-0.04em;margin-top:12px;max-width:24ch}
.post-head .lead{margin-top:14px}
.archive-note{margin-top:24px;padding:14px 18px;border:1px solid var(--line);border-radius:var(--r);background:var(--surface-2);font-size:14.5px;color:var(--fg-2);max-width:72ch}
.archive-note a{color:var(--accent);font-weight:600}
.post-cover{margin-top:28px;border-radius:var(--r-lg);width:100%;height:auto;max-width:900px}
.post-body{margin-top:28px}
.post-body img{border-radius:var(--r);margin-top:14px;height:auto}
.post-foot{margin-top:36px;padding-top:18px;border-top:1px solid var(--line)}
</style>
