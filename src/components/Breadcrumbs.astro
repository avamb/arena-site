---
/** Visible breadcrumbs (the same list feeds BreadcrumbList JSON-LD). Internal links with real anchor text. */
import type { LanguageCode } from '@config';
import { t } from '@/lib/i18n';
interface Props { lang: LanguageCode; items: { name: string; path: string }[] }
const { lang, items } = Astro.props;
---
{items.length > 1 && (
  <nav class="crumbs" aria-label={t(lang, 'breadcrumbs')}>
    <ol>
      {items.map((b, i) => (
        <li>{i < items.length - 1 ? <a href={b.path}>{b.name}</a> : <span aria-current="page">{b.name}</span>}</li>
      ))}
    </ol>
  </nav>
)}
<style is:global>
.crumbs{font-size:13.5px;color:var(--fg-3);padding-top:20px}
.crumbs ol{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:6px}
.crumbs li+li::before{content:"/";margin-inline-end:6px;color:var(--line-2)}
.crumbs a{color:var(--fg-2)}
.crumbs a:hover{color:var(--fg)}
</style>
