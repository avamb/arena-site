---
import type { Section } from '@/content.config';
import type { CollectionEntry } from 'astro:content';
import type { LanguageCode } from '@config';
import { inline, fill } from '@/lib/inline';
import { tariff, packageLinks } from '@/lib/data';
import { localePath, currencySymbol, getLanguage, t } from '@/lib/i18n';
import { lowPriceFee, packageFee, packageCapacity, venueFee } from '@/lib/fees';
import { trackLabel } from '@/lib/track';
import FeeCalculator from '@/components/islands/FeeCalculator.svelte';
interface Props { s: Extract<Section, { type: 'pricing' }>; pricing: CollectionEntry<'pricing'>[]; lang: LanguageCode; top?: boolean }
const { s, pricing, lang, top = false } = Astro.props;
const intl = getLanguage(lang).intl;
const Sub = s.title ? 'h3' : 'h2';
const fmt = (n: number, c: string) => `${currencySymbol(c)}${n.toLocaleString(intl, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
const base = pricing[0];
const baseCur = base.data.currency;
const seated = +(base.data.per_ticket + base.data.seating_extra).toFixed(2);
const lp = tariff.low_price;
// Placeholders of the copy; amounts are shown in the first region's currency, the numbers are equal everywhere.
const vars = {
  percent: tariff.venues_percent,
  lowPercent: lp.percent, lowMax: `${currencySymbol(baseCur)}${lp.max_ticket}`, lowMin: fmt(lp.min, baseCur), lowCap: fmt(lp.max, baseCur), lowSeat: fmt(lp.seating_extra, baseCur),
  cap: fmt(seated, baseCur),
};
const lowExamples = [2, 5, 9, 10];
const exOf = (price: number) => ({ price, plain: lowPriceFee(price, lp, false), seat: lowPriceFee(price, lp, true) });
const ps = tariff.package_seating_extra;
const saving = (fee: number) => Math.round((1 - fee / base.data.per_ticket) * 100);
const calcText = s.calculator;
const buy = s.packages?.buy;
const buyCurrencies = [{ id: 'usd', sym: 'US$' }, { id: 'eur', sym: '€' }];
const minPack = Math.min(...tariff.packages.map((p) => p.per_ticket));
const maxSaving = saving(minPack);
const planVars = (p: (typeof pricing)[number]) => {
  const c = p.data.currency;
  return {
    price: fmt(p.data.per_ticket, c), seated: fmt(p.data.per_ticket + p.data.seating_extra, c),
    from: fmt(minPack, c), fromSeated: fmt(minPack + ps, c), saving: maxSaving,
    lowPercent: lp.percent, lowMax: `${currencySymbol(c)}${lp.max_ticket}`, percent: tariff.venues_percent,
  };
};
// Currency switch: US dollars first, as the base; euro for venues in EU countries.
const byCur = [...pricing].sort((a, b) => (a.data.currency === 'USD' ? -1 : b.data.currency === 'USD' ? 1 : 0));
const amt = (pick: (v: ReturnType<typeof planVars>) => string | number) =>
  byCur.map((p) => `<span class="c-${p.data.currency.toLowerCase()}">${pick(planVars(p))}</span>`).join('');
const fillCur = (text: string) => text.replace(/\{(\w+)\}/g, (m, k) => (k in planVars(base) ? amt((v) => (v as Record<string, string | number>)[k]) : m));
const regions = pricing.map((p) => ({
  id: p.id,
  label: p.data.region,
  symbol: currencySymbol(p.data.currency),
  perTicket: p.data.per_ticket,
  seatingExtra: p.data.seating_extra,
}));
---
<section class="section" id={s.id} style={top ? 'padding-top:0' : undefined}>
  <div class="wrap">
    {s.eyebrow && <p class="eyebrow">{s.eyebrow}</p>}
    {s.title && <h2 class="h2">{s.title}</h2>}
    {s.lead && <p class="lead" set:html={inline(s.lead)} />}
    {s.plans ? (
      <div class="pc">
        {byCur.map((p, i) => <input type="radio" name="planCur" id={`pc-${p.data.currency.toLowerCase()}`} checked={i === 0} class="pc-in" />)}
        <div class="pc-pick" role="group" aria-label={s.plans.currency}>
          <span>{s.plans.currency}</span>
          {byCur.map((p) => <label for={`pc-${p.data.currency.toLowerCase()}`}>{p.data.currency === 'USD' ? '$ USD' : `${currencySymbol(p.data.currency)} ${p.data.currency}`}</label>)}
        </div>
        <div class="plans">
          <div class="card plan">
            <div class="reg">{s.plans.payg.name}</div>
            <p class="plan-text" set:html={fillCur(inline(s.plans.payg.text))} />
            <div class="big num" set:html={`${amt((v) => v.price)}<small>${t(lang, 'pricing.perTicket')}</small>`} />
            <ul>{s.plans.payg.bullets.map((b) => <li set:html={fillCur(inline(b))} />)}</ul>
            <a class="btn btn-ghost" href={localePath(lang, s.cta.href)}>{s.cta.label}</a>
          </div>
          <div class="card plan hi">
            <div class="reg">{s.plans.upfront.name}</div>
            <p class="plan-text" set:html={fillCur(inline(s.plans.upfront.text))} />
            <div class="big num" set:html={`<small class="pre">${s.plans.upfront.from}</small>${amt((v) => v.from)}<small>${t(lang, 'pricing.perTicket')}</small>`} />
            <ul>{s.plans.upfront.bullets.map((b) => <li set:html={fillCur(inline(b))} />)}</ul>
            {s.buyCredits && <a class="btn btn-credits" href={localePath(lang, s.buyCredits.href)}>{s.buyCredits.label}</a>}
          </div>
        </div>
        <div class="perks">
          {s.plans.perks.map((k) => (
            <div class="card perk"><div class="perk-big num" set:html={fillCur(k.big)} /><div><b set:html={fillCur(k.title)} /><p set:html={fillCur(inline(k.text))} /></div></div>
          ))}
        </div>
        <p class="pr-note brand-line" set:html={inline(s.plans.brand)} />
      </div>
    ) : (
    <div class="plans">
      {pricing.map((p) => (
        <div class:list={['card plan', { hi: p.data.highlighted }]}>
          <div class="reg">{p.data.region}</div>
          <div class="big num">{fmt(p.data.per_ticket, p.data.currency)}<small>{t(lang, 'pricing.perTicket')}</small></div>
          <ul>{s.planBullets.map((b) => <li set:html={inline(fill(b, { seated: fmt(p.data.per_ticket + p.data.seating_extra, p.data.currency) }))} />)}</ul>
          <a class:list={['btn', p.data.highlighted ? 'btn-primary' : 'btn-ghost']} href={localePath(lang, s.cta.href)} data-track={trackLabel(s.cta.href, 'plan')}>{s.cta.label}</a>
        </div>
      ))}
    </div>
    )}
    <p class="pr-note" set:html={inline(s.currencyNote)} />
    {s.buyCredits && !s.plans && <p style="margin-top:18px"><a class="btn btn-credits" href={localePath(lang, s.buyCredits.href)} data-track="credits.buy">{s.buyCredits.label}</a></p>}

    {!s.compact && s.packages && (
      <div class="card pkgs" id="packages">
        <Sub class="h3">{s.packages.title}</Sub>
        <p class="pr-note" style="margin-top:6px" set:html={inline(s.packages.text)} />
        {buy && (
          <fieldset class="cur-pick">
            <legend>{buy.currency}</legend>
            {buyCurrencies.map((c, i) => <><input type="radio" name="buyCur" id={`cur-${c.id}`} checked={i === 0} /><label for={`cur-${c.id}`}>{c.sym}</label></>)}
          </fieldset>
        )}
        {buy?.note && <p class="pr-note" style="margin-top:8px"><strong>{buy.note}</strong></p>}
        <div class="tbl-wrap">
          <table class="tbl">
            <thead>
              <tr>
                <th>{s.packages.cols.name}</th><th>{s.packages.cols.prepay}</th><th>{s.packages.cols.plain}</th><th>{s.packages.cols.seated}</th>
                <th>{s.packages.cols.plainCount}</th><th>{s.packages.cols.seatedCount}</th><th>{s.packages.cols.saving}</th>{buy && <th>{s.packages.cols.buy}</th>}
              </tr>
            </thead>
            <tbody>
              {tariff.packages.map((p) => (
                <tr>
                  <th scope="row">{p.name}</th>
                  <td class="num">{fmt(p.prepay, baseCur)}</td>
                  <td class="num">{fmt(packageFee(p, ps, false), baseCur)}</td>
                  <td class="num">{fmt(packageFee(p, ps, true), baseCur)}</td>
                  <td class="num">{packageCapacity(p, ps, false).toLocaleString(intl)}</td>
                  <td class="num">{packageCapacity(p, ps, true).toLocaleString(intl)}</td>
                  <td class="num">{saving(p.per_ticket)}%</td>
                  {buy && (
                    <td class="buy-cell">
                      {buyCurrencies.map((c) => packageLinks[p.name]?.[c.id]
                        ? <a class={`btn btn-primary btn-sm buy-${c.id}`} href={packageLinks[p.name][c.id]} rel="noopener">{buy.label} · {c.sym}{p.prepay.toLocaleString(intl, { minimumFractionDigits: Number.isInteger(p.prepay) ? 0 : 2, maximumFractionDigits: 2 })}</a>
                        : <a class={`btn btn-ghost btn-sm buy-${c.id}`} href={localePath(lang, buy.noneHref)}>{buy.none}</a>)}
                    </td>
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="pr-note" set:html={inline(s.packages.note)} />
      </div>
    )}

    <div class="card venues" id="low-price">
      <div class="big num">{lp.percent}%</div>
      <div>
        <Sub class="h3">{s.lowPrice.title.replace('{lowMax}', vars.lowMax)}</Sub>
        <p set:html={inline(fill(s.lowPrice.text, vars))} />
        {!s.compact && s.lowPrice.cols && (
          <>
            <p class="pr-note" style="margin-top:10px">{s.lowPrice.example}</p>
            <div class="tbl-wrap">
              <table class="tbl tbl-sm">
                <thead><tr><th>{s.lowPrice.cols.price}</th><th>{s.lowPrice.cols.plain}</th><th>{s.lowPrice.cols.seated}</th></tr></thead>
                <tbody>
                  {lowExamples.map(exOf).map((e) => (
                    <tr><th scope="row">{fmt(e.price, baseCur)}</th><td class="num">{fmt(e.plain, baseCur)}</td><td class="num">{fmt(e.seat, baseCur)}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )}
      </div>
    </div>

    <div class="card venues" id="venues">
      <div class="big num">{tariff.venues_percent}%</div>
      <div>
        <Sub class="h3">{s.venues.title}</Sub>
        <p set:html={inline(fill(s.venues.text, vars))} />
        {!s.compact && s.venues.example && <p class="pr-note" style="margin-top:10px">{fill(s.venues.example, { ...vars, ex25: fmt(25, baseCur), ex: fmt(venueFee(25, tariff.venues_percent, seated), baseCur), capAt: fmt(seated * 100 / tariff.venues_percent, baseCur) })}</p>}
      </div>
      <a class="btn btn-ghost btn-sm" href={localePath(lang, s.venues.cta.href)} data-track={trackLabel(s.venues.cta.href, 'venues')}>{s.venues.cta.label}</a>
    </div>

    {!s.compact && s.calculator && (
      <FeeCalculator
        client:idle
        labels={s.calculator}
        regions={regions.map((r) => ({ ...r, label: r.id === 'eu' ? calcText!.regionEu : calcText!.regionWorld }))}
        lowPrice={lp}
        packages={tariff.packages}
        packageSeatingExtra={ps}
        defaultPrice={tariff.calculator.default_price}
        defaultQuantity={tariff.calculator.default_quantity}
        intl={intl}
      />
    )}
    <p class="pr-note"><span set:html={inline(s.note)} /> <a href={localePath(lang, s.terms.href)} style="color:var(--accent);font-weight:600">{s.terms.label}</a></p>
  </div>
</section>
