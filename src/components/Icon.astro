---
/**
 * The one icon set (DESIGN.md): Lucide-style 24px outlines, stroke 1.8, currentColor, taken from
 * the approved prototype. Keys use Lucide names. `telegram` is a brand mark, the single exception.
 */
interface Props { name: keyof typeof icons; size?: number; class?: string; label?: string }
const icons = {
  music: '<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>',
  drama: '<path d="M3 10h18M5 10v9h14v-9M8 19v-5h8v5M12 3l8 4H4z"/>',
  box: '<path d="M3 7l9-4 9 4v10l-9 4-9-4z"/><path d="M12 3v18M3 7l9 4 9-4"/>',
  tent: '<path d="M4 20l4-14 4 8 3-5 5 11z"/>',
  waypoints: '<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="12" r="2.5"/><circle cx="8" cy="18" r="2.5"/><path d="M8 7.5l8 3.5M16 13.5l-6 3"/>',
  mic: '<path d="M8 3h8v5a4 4 0 0 1-8 0zM12 12v6M8 21h8"/>',
  building: '<path d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-6h6v6"/>',
  moon: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6"/>',
  'chevron-down': '<path d="M6 9l6 6 6-6"/>',
  paperclip: '<path d="M21 11.5l-8.5 8.5a5 5 0 0 1-7-7l9-9a3.5 3.5 0 0 1 5 5l-9 9a2 2 0 0 1-3-3l8-8"/>',
  check: '<path d="M5 12l5 5L20 7"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  x: '<path d="M6 6l12 12M18 6L6 18"/>',
  telegram: '<path fill="currentColor" stroke="none" d="M21.9 4.6L3.3 11.8c-1.2.5-1.2 1.2-.2 1.5l4.7 1.5 1.8 5.6c.2.6.4.8.8.8.5 0 .7-.2 1-.5l2.4-2.3 4.9 3.6c.9.5 1.5.2 1.8-.8l3.2-15.2c.3-1.3-.5-1.9-1.8-1.4zM9.3 14.4l8.9-5.6c.4-.3.8-.1.5.2l-7.4 6.7-.3 3.1z"/>',
} as const;
const { name, size, class: cls, label } = Astro.props;
const body = icons[name];
---
<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={body}
/>
