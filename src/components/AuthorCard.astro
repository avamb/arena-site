---
/**
 * Author of an article (content/data/authors.yaml): photo, name, role, bio. `full` on the author page
 * (the page h1 carries the name; with the LinkedIn link, rel="me"); compact under a post, linking the author page.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Author } from '@/lib/data';
import { t } from '@/lib/i18n';
import type { LanguageCode } from '@config';
interface Props { author: Author; lang: LanguageCode; full?: boolean }
const { author, lang, full = false } = Astro.props;
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/images/authors/*.{jpg,jpeg,png,webp}', { eager: true });
const photo = photos[`/src/images/authors/${author.photo}`]?.default;
---
<div class:list={['author-card', { full }]}>
  {photo && <Image class="author-photo" src={photo} alt={author.name} width={full ? 320 : 192} height={full ? 320 : 192} fit="cover" position="top" />}
  <div>
    {!full && <p class="eyebrow">{t(lang, 'post.aboutAuthor')}</p>}
    {!full && <p class="author-name"><a href={author.page}>{author.name}</a></p>}
    <p class="author-role">{author.role}</p>
    <p class="author-bio">{author.bio}</p>
    {full && author.sameAs.map((u) => <p class="author-link"><a href={u} rel="me noopener">{u.includes('linkedin.com') ? 'LinkedIn' : new URL(u).hostname}</a></p>)}
  </div>
</div>
<style>
.author-card{display:flex;gap:18px;align-items:flex-start;max-width:72ch}
.author-photo{border-radius:50%;object-fit:cover;flex:none;width:72px;height:72px}
.full .author-photo{width:160px;height:160px}
.author-name{font-weight:700;font-size:18px;margin:2px 0 0}
.author-name a,.author-link a{color:var(--accent)}
.author-role{color:var(--fg-2);margin-top:2px}
.full .author-role{font-weight:700;font-size:18px;color:var(--fg);margin-top:0}
.author-bio{margin-top:8px;color:var(--fg-2)}
.author-link{margin-top:10px;font-weight:600}
@media (max-width:560px){.full{flex-direction:column}}
</style>
