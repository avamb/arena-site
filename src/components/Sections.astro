---
/** Renders a page: breadcrumbs and h1 (inner pages), sections in YAML order, "Read next" before the final CTA. */
import type { LoadedPage } from '@/lib/pages';
import Section from './Section.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Related from './Related.astro';
interface Props { p: LoadedPage }
const { p } = Astro.props;
const { lang, page } = p;
const hasHero = page.data.sections.some((s) => s.type === 'hero');
const sections = page.data.sections;
const lastIsCta = sections.length > 0 && sections[sections.length - 1].type === 'cta';
const body = lastIsCta ? sections.slice(0, -1) : sections;
const tail = lastIsCta ? sections[sections.length - 1] : null;
const related = page.data.related ?? [];
---
{!hasHero && (
  <div class="wrap page-head">
    <Breadcrumbs lang={lang} items={p.jsonld.breadcrumbs ?? []} />
    <h1>{page.data.h1 ?? page.data.title}</h1>
    {page.data.lead && <p class="lead">{page.data.lead}</p>}
  </div>
)}
{/* A hidden deletion-status block (shown only with ?code=) must not take the first section's top padding. */}
{body.map((s, i) => <Section p={p} s={s} first={!hasHero && i === body.findIndex((x) => x.type !== 'deletion-status')} />)}
<Related lang={lang} items={related} />
{tail && <Section p={p} s={tail} first={false} />}
