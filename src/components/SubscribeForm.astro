---
/**
 * E-mail subscription form (warm list). One markup for the popup (dialog and mobile bar) and the permanent
 * footer strip. Modelled on ContactForm: honeypot `website`, Turnstile (here `interaction-only`, so it adds
 * no height unless a challenge is needed, and it loads on the first focus or input, not on page load),
 * JSON POST to /api/subscribe (worker/subscribe.ts). Strings: i18n `subscribe.*`.
 * Client logic: src/scripts/subscribe.ts, rules and payload: src/scripts/subscribe-lib.ts.
 */
import type { LanguageCode } from '@config';
import { turnstileSiteKey, subscribe, org } from '@config';
import { t, localePath } from '@/lib/i18n';
import { inline } from '@/lib/inline';
interface Props { lang: LanguageCode; prefix: string; variant: 'popup' | 'footer' }
const { lang, prefix, variant } = Astro.props;
const id = (k: string) => `${prefix}-${k}`;
const errors = ['invalid', 'turnstile', 'rate', 'unavailable', 'network'].reduce<Record<string, string>>((m, k) => ({ ...m, [k]: t(lang, `subscribe.error.${k}`, { email: org.contactEmail }) }), {});
---
<form class={`sub-form sub-${variant}`} novalidate data-subscribe-form data-source={variant} data-lang={lang} data-sitekey={turnstileSiteKey} data-consent={subscribe.consentVersion} data-errors={JSON.stringify(errors)} data-sent={t(lang, 'subscribe.sent')} data-sending={t(lang, 'subscribe.sending')} aria-label={t(lang, 'subscribe.popup.title')}>
  <p class="sub-value">{t(lang, 'subscribe.value')}</p>
  <div class="sub-row">
    <div class="field sub-field">
      <label class="visually-hidden" for={id('email')}>{t(lang, 'subscribe.email')}</label>
      <input id={id('email')} name="email" type="email" inputmode="email" autocomplete="email" maxlength="200" placeholder={t(lang, 'subscribe.placeholder')} required />
    </div>
    <button class="btn btn-primary" type="submit">{t(lang, 'subscribe.button')}</button>
  </div>
  <div class="contact-hp" aria-hidden="true">
    <label for={id('website')}>Website</label>
    <input id={id('website')} name="website" tabindex="-1" autocomplete="off" />
  </div>
  <div class="cf-turnstile-box sub-ts" data-turnstile></div>
  <p class="sub-consent" set:html={inline(t(lang, 'subscribe.consent'), { resolve: (href) => localePath(lang, href) })} />
  <p class="form-status" role="status" aria-live="polite" data-status></p>
</form>
