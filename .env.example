# One set of names for every runtime (doc 33 §3.7a): `wrangler secret put <NAME>` for the Worker,
# the container environment for nginx + Node. Nothing here is a value; copy to .env for local runs.

# Build-time (Astro)
SITE_URL=https://new.arenasoldout.com      # canonical origin of this build
SITE_INDEXING=false                        # true on launch day (also flips robots.txt, noindex, X-Robots-Tag)

# The application form (/start) has no server part on this site: it calls the platform API from the
# browser and the platform verifies Turnstile with its own secret. No runtime secrets are needed here.

# Deploy (GitHub Actions secrets, never in files)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
